{
  "kind": "collectionType",
  "collectionName": "design_articles",
  "info": {
    "singularName": "design-article",
    "pluralName": "design-articles",
    "displayName": "Design Article"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "summary": {
      "type": "text",
      "required": true
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "text": {
      "type": "richtext"
    },
    "issue": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::issue.issue",
      "inversedBy": "design_articles"
    },
    "isVerticalFeatured": {
      "type": "boolean"
    },
    "isHorizontalFeatured": {
      "type": "boolean"
    }
  }
}
