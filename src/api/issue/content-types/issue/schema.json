{
  "kind": "collectionType",
  "collectionName": "issues",
  "info": {
    "singularName": "issue",
    "pluralName": "issues",
    "displayName": "Issue"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "volume": {
      "type": "uid",
      "required": true
    },
    "date": {
      "type": "string"
    },
    "highlights": {
      "type": "component",
      "component": "shared.issue-highlight",
      "repeatable": true,
      "required": true
    },
    "pdf": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "stories": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::story.story",
      "mappedBy": "issue"
    },
    "design_articles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::design-article.design-article",
      "mappedBy": "issue"
    }
  }
}
