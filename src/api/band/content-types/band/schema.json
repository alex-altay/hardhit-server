{
  "kind": "collectionType",
  "collectionName": "bands",
  "info": {
    "singularName": "band",
    "pluralName": "bands",
    "displayName": "Band"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "stories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::story.story",
      "mappedBy": "bands"
    },
    "photos_collections": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::photos-collection.photos-collection",
      "mappedBy": "band"
    },
    "live_links": {
      "type": "component",
      "component": "shared.video-link",
      "repeatable": true
    },
    "interview_links": {
      "type": "component",
      "component": "shared.video-link",
      "repeatable": true
    }
  }
}
